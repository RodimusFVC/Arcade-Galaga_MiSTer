        <part>
            01 90 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 04 00 03 00 0C 00 0B 05 0D 13 14 11 12 16 00
            00 00 00 00 00 24 00 00 00 00 00 00 00 00 00 00
