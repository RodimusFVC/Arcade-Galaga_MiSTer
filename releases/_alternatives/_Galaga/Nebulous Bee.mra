        <part crc="86d92b24" name="1d.bin"/>
        <part repeat="0x9700">00</part>
        <part crc="c2f57ef8" name="51xx.bin"/>
    </rom>

    <!-- Index 1: board variant, flags, input map (see Arcade-Galaga.sv) -->
