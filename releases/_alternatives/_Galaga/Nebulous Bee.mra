        <part crc="8995088d" name="gg1-7"/>
        <part repeat="0x3000">00</part>
        <part crc="58b2f47c" name="gg1_9.4l"/>
        <part repeat="0x1000">00</part>
        <part crc="035e300c" name="nebulbee.07"/>
