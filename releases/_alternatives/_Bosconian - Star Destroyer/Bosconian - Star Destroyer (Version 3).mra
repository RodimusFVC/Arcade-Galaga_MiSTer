<misterromdescription>
    <name>Bosconian - Star Destroyer (Version 3)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Bosconian</series>
    <year>1981</year>
    <manufacturer>Namco</manufacturer>
    <category>Shooter</category>

    <setname>bosco3</setname>
    <parent>bosco</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaga</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FF,F7,A7">
        <dip name="Service Mode" bits="15" ids="Off,On" values="1,0"/>
        <dip name="Difficulty" bits="16,17" ids="Easy,Medium,Hardest,Auto" values="1,3,2,0"/>
        <dip name="Allow Continue" bits="18" ids="No,Yes"/>
        <dip name="Demo Sounds" bits="19" ids="Off,On" values="1,0"/>
        <dip name="Freeze" bits="20" ids="Off,On" values="1,0"/>
        <dip name="Cabinet" bits="23" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Coinage" bits="24,26" ids="4C/1C,3C/1C,2C/1C,1C/1C,2C/3C,1C/2C,1C/3C,Free Play" values="1,2,3,7,4,6,5,0"/>
        <dip name="Bonus Fighter" bits="27,29" ids="15K and 50K Only,20K and 70K Only,10K; 50K; Every 50K,15K; 50K; Every 50K,15K; 70K; Every 70K,20K; 70K; Every 70K,30K; 100K; Every 100K,None" values="6,7,1,2,3,4,5,0"/>
        <dip name="Lives" bits="30,31" ids="1,2,3,5"/>
    </switches>

