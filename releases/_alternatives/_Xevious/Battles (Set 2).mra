    <switches default="FF,FF,FF,FF">
        <dip name="Service Mode" bits="15" ids="Off,On" values="1,0"/>
        <dip name="Coin A" bits="16,17" ids="2C/1C,1C/1C,2C/3C,1C/2C" values="1,3,0,2"/>
        <dip name="Bonus Life" bits="18,20" ids="10K; 40K; Every 40K,10K; 50K; Every 50K,20K; 50K; Every 50K,20K; 60K; Every 60K,20K; 70K; Every 70K,20K; 80K; Every 80K,20K and 60K Only,None" values="6,5,4,7,3,2,1,0"/>
        <dip name="Lives" bits="21,22" ids="1,2,3,5" values="2,1,3,0"/>
        <dip name="Cabinet" bits="23" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Flags Award Bonus Life" bits="25" ids="No,Yes"/>
        <dip name="Coin B" bits="26,27" ids="2C/1C,1C/1C,2C/3C,1C/2C" values="1,3,0,2"/>
        <dip name="Difficulty" bits="29,30" ids="Easy,Normal,Hard,Hardest" values="2,3,1,0"/>
        <dip name="Freeze" bits="31" ids="Off,On" values="1,0"/>
    </switches>

