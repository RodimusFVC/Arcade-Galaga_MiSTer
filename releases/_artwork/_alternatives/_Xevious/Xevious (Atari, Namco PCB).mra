<misterromdescription>
    <name>Xevious (Atari, Namco PCB)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Xevious</series>
    <year>1982</year>
    <manufacturer>Namco (Atari license)</manufacturer>
    <category>Shooter</category>

    <setname>xeviousc</setname>
    <parent>xevious</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaga</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FF,FF,FF">
        <dip name="Service Mode" bits="15" ids="Off,On" values="1,0"/>
        <dip name="Coin A" bits="16,17" ids="2C/1C,1C/1C,2C/3C,1C/2C" values="1,3,0,2"/>
        <dip name="Bonus Life" bits="18,20" ids="10K; 40K; Every 40K,10K; 50K; Every 50K,20K; 50K; Every 50K,20K; 60K; Every 60K,20K; 70K; Every 70K,20K; 80K; Every 80K,20K and 60K Only,None" values="6,5,4,7,3,2,1,0"/>
        <dip name="Lives" bits="21,22" ids="1,2,3,5" values="2,1,3,0"/>
        <dip name="Cabinet" bits="23" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Flags Award Bonus Life" bits="25" ids="No,Yes"/>
        <dip name="Difficulty" bits="29,30" ids="Easy,Normal,Hard,Hardest" values="2,3,1,0"/>
        <dip name="Coin B" bits="26,27" ids="1C/1C,1C/2C,1C/3C,1C/6C" values="3,2,1,0"/>
        <dip name="Copyright" bits="31" ids="Namco,Atari/Namco"/>
    </switches>

