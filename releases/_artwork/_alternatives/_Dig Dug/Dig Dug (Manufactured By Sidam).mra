    <rbf>Galaga</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FF,99,24">
        <dip name="Service Mode" bits="15" ids="Off,On" values="1,0"/>
        <dip name="Coin B" bits="16,18" ids="3C/1C,2C/1C,1C/1C,2C/3C,1C/2C,1C/3C,1C/6C,1C/7C" values="7,3,1,5,6,2,4,0"/>
        <dip name="Bonus Life" bits="19,21" ids="10K; 40K; Every 40K,10K; 50K; Every 50K,20K; 60K; Every 60K,20K; 70K; Every 70K,10K and 40K Only,20K and 60K Only,10K Only,None" values="4,2,6,1,5,3,7,0"/>
        <dip name="Lives" bits="22,23" ids="1,2,3,5"/>
        <dip name="Coin A" bits="30,31" ids="2C/1C,1C/1C,2C/3C,1C/2C" values="1,0,3,2"/>
        <dip name="Freeze" bits="29" ids="Off,On" values="1,0"/>
        <dip name="Demo Sounds" bits="28" ids="Off,On" values="1,0"/>
        <dip name="Allow Continue" bits="27" ids="No,Yes" values="1,0"/>
        <dip name="Cabinet" bits="26" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Difficulty" bits="24,25" ids="Easy,Medium,Hard,Hardest" values="0,2,1,3"/>
    </switches>

